# WARNING: adding this file REPLACES .gitignore as npm pack's exclusion source — it does not
# merge with it. Everything .gitignore excludes must be repeated here, or it lands in the
# deployed component. See docs/structure.md.
node_modules/
*.tsbuildinfo
.env
.env.local
/.claude/
.DS_Store

# The dataset is committed to git (it is the benchmark's contract) but must NOT ship in the
# deploy payload: it is ~800 MB and is loaded separately via the operations API, outside the
# measured run. See scripts/load-dataset.mjs.
dataset/

# Harness output and the harness itself are not part of the application.
bench/
e2e/
