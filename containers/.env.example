# Copy to containers/.env before running. Local TEST credentials for a container that only
# ever gets benchmarked on this machine — Harper's installer requires them to run
# non-interactively, and nothing here is reachable beyond the compose bridge network.
#
#   node -e "console.log(require('node:crypto').randomBytes(18).toString('base64url'))"
HDB_ADMIN_USERNAME=benchadmin
HDB_ADMIN_PASSWORD=replace-me

# The target's budget. A competing stack fits its ENTIRE architecture inside this.
TARGET_CPUS=2
TARGET_MEMORY=2g
HARPER_THREADS=2

# The load generator sits OUTSIDE the target's budget.
BENCH_CPUS=2
BENCH_MEMORY=1g
