{
  "name": "ecommerce-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Harper Ecommerce Store \u2014 the golden reference implementation for the Harper application architecture benchmarks.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "harper dev .",
    "start": "harper run .",
    "seed": "npm run seed --workspace @ecommerce-store/seed",
    "typecheck": "tsc --build",
    "test:e2e": "npm test --prefix e2e",
    "check": "npm run check:spec && npm run check:coverage && npm run typecheck && npm run check:deploy",
    "check:spec": "node scripts/check-spec-sync.mjs",
    "check:coverage": "npm run coverage --prefix e2e",
    "check:deploy": "./scripts/verify-deploy.sh"
  },
  "dependencies": {
    "@ecommerce-store/spec": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "harper": "5.2.12",
    "typescript": "7.0.2",
    "@ecommerce-store/seed": "*"
  }
}
